+        e->chash_ok = 0;
+        if (ch < 0) content_check(e, ch);   // the hash of what the upload reads
+        upload(e);
+        return;
+    }
     e->last_ch = ch;
-    if (ch) upload(e);
+    if (content_check(e, ch)) upload(e);
 }
 
