+// Storage the platform does not write-watch (the PS5: plat_mem_written answers untracked) has no page generations, so
+// "not tracked" used to mean "upload again" at every check: every ASTC texture a frame bound was decoded again each
+// submission (the title screen at 0.1 fps, 8 s of ASTC decodes a frame). There the storage's own bytes decide, as in
+// WSword's texture cache on the console (SheikahSlate pc/runtime/nvn/vulkan/textures.c upload_texture, which BotW
+// runs with on the PS5): a full hash before the first upload; then a check once a frame at most, every 8th frame for
+// a texture whose content never changed (staggered by the entry's address), which reads 8 bytes at 2,048 places and
+// hashes in full only when that sample differs, or after 120 frames within 4 MiB of full hashes a frame; a texture
+// whose content did change (dynamic) is hashed in full at every check. A different full hash uploads again.
+// TOTK_TEX_FULLHASH=1 hashes every texture in full at every check (no sample, no stagger).
+static uint64_t storage_hash(const uint8_t *p, uint64_t n) {   // four independent lanes: the multiplies overlap
+    uint64_t a = 0x9e3779b97f4a7c15ull ^ n, b = 0xc2b2ae3d27d4eb4full, c = 0x165667b19e3779f9ull,
+             d = 0x27d4eb2f165667c5ull;
+    const uint64_t K = 0xff51afd7ed558ccdull;
+#define TEX_MIX(h, w) (h = (h ^ (w)) * K, h = (h << 31) | (h >> 33))
+    for (; n >= 32; p += 32, n -= 32) {
+        uint64_t w[4];
+        memcpy(w, p, 32);
+        TEX_MIX(a, w[0]), TEX_MIX(b, w[1]), TEX_MIX(c, w[2]), TEX_MIX(d, w[3]);
+    }
+    for (; n >= 8; p += 8, n -= 8) {
+        uint64_t w;
+        memcpy(&w, p, 8);
+        TEX_MIX(a, w);
+    }
+    if (n) {
+        uint64_t w = 0;
+        memcpy(&w, p, n);
+        TEX_MIX(b, w);
+    }
+#undef TEX_MIX
+    uint64_t h = a ^ (b * 0xc4ceb9fe1a85ec53ull) ^ (c * K) ^ (d * 0x9e3779b97f4a7c15ull);
+    h ^= h >> 33, h *= 0xc4ceb9fe1a85ec53ull, h ^= h >> 33;
+    return h;
+}
+
+static uint64_t storage_sample(const uint8_t *p, uint64_t n) {   // 8 bytes at each of up to 2,048 places
+    uint64_t h = 1469598103934665603ull, words = n / 8, step = words > 2048 ? words / 2048 : 1;
+    for (uint64_t i = 0; i < words; i += step) {
+        uint64_t w;
+        memcpy(&w, p + i * 8, 8);
+        h = (h ^ w) * 1099511628211ull, h ^= h >> 29;
+    }
+    for (uint64_t i = words * 8; i < n; i++) h = (h ^ p[i]) * 1099511628211ull;
+    return h ^ n;
+}
+
+static uint64_t hash_budget, hash_budget_frame;   // (replay thread) bytes of scheduled full hashes left this frame
+
+// ch from the write watch; -1 (untracked): whether the storage's bytes changed since the last hash (see above).
+static int content_check(Tex *e, int ch) {
+    if (ch >= 0) {
+        e->chash_ok = 0;   // (tracked: the hash would be stale if the watch ever stops answering)
+        return ch;
+    }
+    static int always_full = -1;
+    if (always_full < 0) always_full = !strcmp(cfg_value("TOTK_TEX_FULLHASH"), "1");
+    uint64_t frame = __atomic_load_n(&gfx_counters.frames, __ATOMIC_RELAXED), n = e->t.L.size;
+    const uint8_t *mem = (const uint8_t *)(uintptr_t)e->pub.addr;
+    int first = !e->chash_ok;
+    if (!first && !always_full) {
+        if (e->hchk_frame == frame) return 0;
+        if (!e->dynamic && ((frame + ((uintptr_t)e >> 6)) & 7)) return 0;
+    }
+    e->hchk_frame = frame;
+    if (hash_budget_frame != frame) hash_budget_frame = frame, hash_budget = 4u << 20;
+    int full = first || always_full || e->dynamic;
+    if (!full && frame - e->hfull_frame >= 120 && hash_budget >= n) full = 1, hash_budget -= n;
+    if (!full && storage_sample(mem, n) == e->shash) return 0;
+    uint64_t h = storage_hash(mem, n);
+    e->hfull_frame = frame, e->shash = storage_sample(mem, n);
+    int changed = first || h != e->chash;
+    if (!first && changed) e->dynamic = 1;
+    e->chash = h, e->chash_ok = 1;
+    return changed;
+}
+
 // A mirrored texture is uploaded on first use and again when its storage pages carry a newer write generation.
 static void make_fresh(Tex *e) {
     if (!e->pub.mirrored || e->pub.gpu_owned) return;
     uint64_t size = e->t.L.size;
     if (!e->uploaded) {
-        vk_mem_changed(e->pub.addr, size, 0, &e->wgen);   // resets the write bits before the storage is read
+        int c0 = vk_mem_changed(e->pub.addr, size, 0, &e->wgen);   // resets the write bits before the storage is read
+        e->chash_ok = 0;
+        if (c0 < 0) content_check(e, c0);   // the hash of what the upload reads
         upload(e);
         return;
     }
@@ -1258,7 +1341,7 @@ static void make_fresh(Tex *e) {
     int ch = vk_mem_changed(e->pub.addr, size, e->wgen, &now);
     e->wgen = now;
     e->last_ch = ch;
-    if (ch) upload(e);   // 1 written, -1 not tracked: both upload again
+    if (content_check(e, ch)) upload(e);   // 1 written, -1 not tracked: the content decides
 }
 
